{
  "name": "se2",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf build",
    "lint": "eslint src",
    "prebuild": "npm run clean && npm run lint",
    "build": "tsc",
    "postbuild": "powershell -Command \"$size=(Get-ChildItem build -Recurse | Measure-Object -Property Length -Sum).Sum; Write-Host ('Build size: {0:N2} KB' -f ($size/1KB))\"",
    "prestart": "npm run build",
    "start": "node build/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "format": "prettier \"src/**/*.{ts,js,json,md}\" --write",
    "format:check": "prettier . --check",
    "test": "jest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "eslint": "^10.0.2",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "jiti": "^2.6.1",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "winston": "^3.19.0"
  }
}
